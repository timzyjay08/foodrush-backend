# ---- Database ---------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@localhost:5432/app_db

# ---- Auth -------------------------------------------------------------
# Use a long, random secret (at least 32 chars). Never commit the real one.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# ---- Redis (optional, required for multi-instance real-time) ----------
# Enables SSE fan-out across load-balanced instances + distributed rate limiting.
REDIS_URL=redis://localhost:6379

# ---- Google Sign-In ---------------------------------------------------
# Create an OAuth 2.0 Web Client ID in Google Cloud Console.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- CORS / frontend (set in production) ------------------------------
FRONTEND_URL=http://localhost:3000
