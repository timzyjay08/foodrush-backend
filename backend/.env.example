# Copy to a .env (or export) before running. Never commit real secrets.

# Database
DB_URL=jdbc:postgresql://localhost:5432/foodrush
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-long-random-password

# JWT (must be at least 32 characters for HS256)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Paystack (required for real payments)
PAYSTACK_SECRET_KEY=
PAYSTACK_SIMULATION_ENABLED=false

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: load demo data on startup
SEED_DATA=false
